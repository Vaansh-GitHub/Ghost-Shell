# ==========================================
# GhostShell Environment Configuration
# ==========================================

# Cloudflare Workers AI Settings
# Model: @cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# ElevenLabs Text-to-Speech Settings
# Model: Flash v2.5 (via Cloudflare partner integration or direct API)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_ghost_voice_id_here
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Audio Playback Settings
# Set GHOST_MUTE=true to disable voice synthesis and playback
GHOST_MUTE=false
# Audio player binary path or command name (e.g., ffplay)
GHOST_AUDIO_PLAYER=ffplay

# General Settings
LOG_LEVEL=info

